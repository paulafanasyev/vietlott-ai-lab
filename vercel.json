{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:route", "destination": "/api/index?route=:route" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "30 13 * * *" },
    { "path": "/api/cron-morning", "schedule": "0 0 * * *" }
  ]
}
